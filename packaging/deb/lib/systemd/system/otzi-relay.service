[Unit]
Description=Otzi-headless relay server (opaque-frame router for relay-transport rings)
# Installed disabled. Run it on ONE coordinator host for the whole ring, behind a
# TLS reverse proxy; enable it there with: systemctl enable --now otzi-relay
# (docs/install.md, Relay coordinator).
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A transient user and group that systemd allocates for each run, never the
# daemon's otzi user: the relay needs no file, and on a coordinator that is also
# a ring node, a compromised relay must not run as the uid that owns the share,
# the identity key and the daemon's environment (Ruling P12). ProtectProc=
# invisible hides every process it does not own, the daemon included.
DynamicUser=yes
ProtectProc=invisible
# Listen address: OTZI_RELAY_LISTEN=<host:port> in /etc/otzi/relay.env (root:root
# 0644, no secrets; the postinst creates it with 127.0.0.1:7100 when it is missing).
# The host is required (an IPv6 host goes in brackets) and there is no built-in
# default, so the relay never binds every interface by accident. systemd reads
# the file as root before it switches to the transient user, which gets the value
# only through its environment (it cannot read /etc/otzi, root:otzi 2750).
EnvironmentFile=/etc/otzi/relay.env
ExecStart=/usr/bin/otzi relay --listen ${OTZI_RELAY_LISTEN}
Restart=on-failure
RestartSec=5

# Hardening, the same as otzi.service. The relay is an unprivileged Node process
# (a transient user, see DynamicUser= above) that routes opaque encrypted frames
# between the daemons: it holds no key, reads no vault file and writes nothing, so
# it gets no ReadWritePaths= and no RuntimeDirectory=. Everything it does not need
# is closed off. (DynamicUser=yes implies some of these too; they are spelled out
# so the unit reads the same as otzi.service.)
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# A private /dev with only null, zero, full, random, urandom, tty and the pty
# devices.
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
# AF_NETLINK: glibc's getaddrinfo (AI_ADDRCONFIG) asks the kernel over netlink
# which address families the host has configured. Without it, resolving a listen
# host name can fail.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
#
# Left out on purpose:
# - MemoryDenyWriteExecute: Node's V8 JIT needs writable+executable memory.
# - SystemCallFilter: kept off for the same reason as otzi.service; an operator
#   can add a filter in a drop-in (systemctl edit otzi-relay).
# - CapabilityBoundingSet= (empty): the relay runs as a transient user with no
#   ambient capabilities, so it holds none already. Emptying the set would only
#   stop an operator from granting one in a drop-in (AmbientCapabilities=
#   CAP_NET_BIND_SERVICE to listen on a port below 1024).

[Install]
WantedBy=multi-user.target
