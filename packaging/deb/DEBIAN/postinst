#!/bin/sh
set -e

. /usr/share/debconf/confmodule

# Escape double-quotes + backslashes for safe inclusion in TOML basic strings.
toml_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

case "$1" in
  configure)
    if ! getent passwd otzi >/dev/null 2>&1; then
      adduser --system --group --no-create-home \
              --home /var/lib/otzi --shell /usr/sbin/nologin otzi
    fi

    # /etc/otzi: 2750 root:otzi (setgid). Only root writes: the config, the
    # address book and the share-password file all decide what the node signs.
    # Group otzi reads and traverses, so the daemon (User=otzi) and operators
    # in the group can read daemon.toml and the address book. New files inherit
    # group otzi via setgid.
    [ -d /etc/otzi ] || mkdir -p /etc/otzi
    chown root:otzi /etc/otzi
    chmod 2750 /etc/otzi

    # /var/lib/otzi: 2770 root:otzi so group-otzi members can run setup
    # (writes identity.json + pubkeys.json) — daemon (otzi user) reads via
    # group membership. Setgid makes new files group-otzi.
    [ -d /var/lib/otzi ] || mkdir -p /var/lib/otzi
    chown root:otzi /var/lib/otzi
    chmod 2770 /var/lib/otzi

    # /var/run/otzi (the UDS socket's directory) is not created here: the unit's
    # RuntimeDirectory= creates it (otzi:otzi 3770) when the daemon starts and
    # removes it when it stops. A directory that outlived the daemon would let a
    # group member plant a socket there for the CLI to trust.

    # Leftovers of earlier releases; nothing reads these files any more.
    rm -f /var/lib/otzi/bootstrap-secret /etc/otzi/manifest.otzi.json

    # daemon.toml and the address book decide what this node signs: root writes
    # them, group otzi reads them. Re-applied on every configure, so a mode or
    # owner loosened since (an editor, a copy) is put back. Symlinks are left
    # alone rather than followed.
    for OTZI_FILE in /etc/otzi/daemon.toml /etc/otzi/address-book.otzi.json; do
      if [ -f "$OTZI_FILE" ] && [ ! -L "$OTZI_FILE" ]; then
        chown root:otzi "$OTZI_FILE"
        chmod 0640 "$OTZI_FILE"
      fi
    done

    # /etc/otzi/relay.env: the listen address of otzi-relay.service (the relay
    # server of a relay-transport ring; docs/install.md, Relay coordinator).
    # Created only when missing, so an operator's edit survives upgrades and
    # reconfigures. It holds no secret, so root:root 0644. The loopback default
    # suits a TLS reverse proxy on the same host. The unit is installed disabled
    # and stays so: enabling it is the operator's decision on the coordinator host.
    if [ ! -e /etc/otzi/relay.env ] && [ ! -L /etc/otzi/relay.env ]; then
      (
        umask 022
        cat >/etc/otzi/relay.env <<'RELAYENV'
# Listen address of the relay server (otzi-relay.service): host:port.
# The host is required (an IPv6 host goes in brackets, e.g. [::1]:7100); there
# is no built-in default. The default below is loopback only: put a TLS reverse
# proxy on this host in front of it. Edit as root, then restart the unit:
#   sudo systemctl restart otzi-relay
# This file holds no secret. The otzi-headless postinst creates it when it is
# missing and never overwrites it.
OTZI_RELAY_LISTEN=127.0.0.1:7100
RELAYENV
      )
      chown root:root /etc/otzi/relay.env
      chmod 0644 /etc/otzi/relay.env
    fi

    # Add operator users to the otzi group.
    db_get otzi-headless/operators || true
    OPERATORS="$RET"
    for U in $OPERATORS; do
      if getent passwd "$U" >/dev/null 2>&1; then
        usermod -aG otzi "$U" || true
        echo "otzi-headless: added user '$U' to group 'otzi'"
      else
        echo "otzi-headless: WARNING — user '$U' does not exist; skipping group add" >&2
      fi
    done

    # Restore-from-backup branch (run BEFORE the daemon.toml render). If the
    # operator picked "yes" at the debconf prompt, pipe the password to
    # `otzi restore --password-stdin <path>` and short-circuit the
    # fresh-install path. NEVER pass the password as an argv flag — it would
    # leak via /proc/<pid>/cmdline + ps. db_reset wipes the password from
    # /var/cache/debconf/passwords.dat on EVERY exit path.
    #
    # It runs only while there is no /etc/otzi/daemon.toml (a fresh install, or
    # one where the operator moved the file aside): `otzi restore` refuses to run
    # over an existing config, and the debconf answer outlives the install, so
    # without this every later upgrade would try the restore again. A restore that
    # succeeds sets the answer back to false.
    db_get otzi-headless/restore-from-backup || true
    RESTORE_REQUESTED="$RET"
    if [ "$RESTORE_REQUESTED" = "true" ] && { [ -e /etc/otzi/daemon.toml ] || [ -L /etc/otzi/daemon.toml ]; }; then
      echo "otzi-headless: WARNING — /etc/otzi/daemon.toml exists; skipping the restore from backup (to restore, move it aside and run: dpkg-reconfigure otzi-headless)" >&2
      db_set otzi-headless/restore-from-backup false || true
      db_reset otzi-headless/backup-password 2>/dev/null || true
      db_reset otzi-headless/backup-path 2>/dev/null || true
      RESTORE_REQUESTED="false"
    fi
    if [ "$RESTORE_REQUESTED" = "true" ]; then
      db_get otzi-headless/backup-path || true
      BACKUP_PATH="$RET"
      db_get otzi-headless/backup-password || true
      BACKUP_PASSWORD="$RET"

      if [ -z "$BACKUP_PATH" ] || [ -z "$BACKUP_PASSWORD" ]; then
        echo "otzi-headless: restore selected but backup-path or backup-password is empty" >&2
        db_reset otzi-headless/backup-password 2>/dev/null || true
        exit 1
      fi

      if [ ! -f "$BACKUP_PATH" ]; then
        echo "otzi-headless: backup file not found at $BACKUP_PATH" >&2
        db_reset otzi-headless/backup-password 2>/dev/null || true
        exit 1
      fi

      echo "otzi-headless: attempting restore from $BACKUP_PATH"
      if printf '%s\n' "$BACKUP_PASSWORD" | otzi restore --password-stdin "$BACKUP_PATH"; then
        # Wipe password from debconf cache before continuing, and take the
        # restore answer back so later upgrades do not repeat it.
        db_reset otzi-headless/backup-password 2>/dev/null || true
        db_reset otzi-headless/backup-path 2>/dev/null || true
        db_set otzi-headless/restore-from-backup false || true
        echo "otzi-headless: restored from backup; skipping fresh-install configuration"
        cat <<'BANNER'

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  otzi-headless restored from backup.

  Verify the restored config:
    sudo cat /etc/otzi/daemon.toml
  Create /etc/otzi/otzi.env (owner root:root, mode 600) with one line;
  the backup does not contain it, and the daemon refuses to start without
  the password:
    sudo install -m 600 -o root -g root /dev/null /etc/otzi/otzi.env
    sudoedit /etc/otzi/otzi.env   # OTZI_SHARE_PASSWORD=<this node's share password>
  Then start the daemon:
    sudo systemctl enable --now otzi
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

BANNER
        db_stop || true
        exit 0
      else
        # Restore failed — wipe password and abort. Operator can
        # `dpkg-reconfigure otzi-headless` to retry (or decline restore).
        db_reset otzi-headless/backup-password 2>/dev/null || true
        echo "otzi-headless: restore failed. To retry: dpkg-reconfigure otzi-headless" >&2
        echo "otzi-headless: (or remove the package + reinstall with a valid backup)" >&2
        exit 1
      fi
    fi

    # Render daemon.toml only if missing — preserve operator edits across upgrades.
    if [ ! -f /etc/otzi/daemon.toml ]; then
      db_get otzi-headless/role || true;                  ROLE="$RET"
      db_get otzi-headless/network || true;               NETWORK="$RET"
      db_get otzi-headless/esplora-url || true;           ESPLORA_URL="$RET"
      db_get otzi-headless/transport || true;             TRANSPORT="$RET"
      db_get otzi-headless/advertised-endpoint || true;   ADVERTISED="$RET"
      db_get otzi-headless/peers || true;                 PEERS_CSV="$RET"
      db_get otzi-headless/relay-url || true;             RELAY_URL="$RET"
      db_get otzi-headless/bootstrap-bind || true;        BOOTSTRAP_BIND="$RET"
      db_get otzi-headless/parties || true;               PARTIES="$RET"
      db_get otzi-headless/bootstrap-leader-url || true;  BOOTSTRAP_LEADER_URL="$RET"
      db_get otzi-headless/node-id || true;               NODE_ID="$RET"

      [ -n "$NODE_ID" ]        || NODE_ID="$(hostname -s 2>/dev/null || hostname)"
      [ -n "$NETWORK" ]        || NETWORK="testnet4"
      [ -n "$TRANSPORT" ]      || TRANSPORT="peer-mesh"
      [ -n "$ROLE" ]           || ROLE="leaf"
      [ -n "$BOOTSTRAP_BIND" ] || BOOTSTRAP_BIND="0.0.0.0:7090"

      # Optional: a blank (or whitespace-only) answer leaves esplora_url out, and
      # the CLI uses the mempool.space default of the network.
      ESPLORA_URL="$(printf '%s' "$ESPLORA_URL" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      # The daemon refuses to start on an esplora_url that is not an http(s) URL, so a
      # value without the scheme is left out of the config rather than written into it.
      case "$ESPLORA_URL" in
        ""|http://?*|https://?*) ;;
        *)
          echo "otzi-headless: WARNING — ignoring Esplora URL '$ESPLORA_URL': it must start with http:// or https://." >&2
          echo "otzi-headless: the CLI will use the mempool.space default; set esplora_url under [network] in /etc/otzi/daemon.toml to change it." >&2
          ESPLORA_URL=""
          ;;
      esac

      # [bootstrap] parties: the ring size, this node included. Only a relay
      # leader takes it (a relay config has no [[peers]] to count; the parser
      # refuses the key under peer-mesh and on a leaf). Only an integer from 2 to
      # 255 is written; anything else is left out with a warning, and `otzi setup`
      # then stops with the config error that names the key. Leading zeros are
      # dropped first (a TOML integer has none); the range is matched as text so
      # an absurdly long answer cannot overflow a numeric test.
      PARTIES_OK=""
      if [ "$TRANSPORT" = "relay" ] && [ "$ROLE" = "leader" ]; then
        PARTIES="$(printf '%s' "$PARTIES" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        PARTIES_NUM="$(printf '%s' "$PARTIES" | sed -e 's/^0*\([0-9]\)/\1/')"
        case "$PARTIES_NUM" in
          [2-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]) PARTIES_OK="$PARTIES_NUM" ;;
          *)
            if [ -z "$PARTIES" ]; then
              echo "otzi-headless: WARNING — no ring size given: the number of nodes (this one included) must be an integer from 2 to 255." >&2
            else
              echo "otzi-headless: WARNING — ignoring ring size '$PARTIES': the number of nodes (this one included) must be an integer from 2 to 255." >&2
            fi
            echo "otzi-headless: set parties under [bootstrap] in /etc/otzi/daemon.toml before running 'otzi setup'." >&2
            ;;
        esac
      fi

      # [transport] url (relay): the daemon dials it as a WebSocket, so only a ws:// or
      # wss:// URL is written. A blank or other answer is left out with a warning, and
      # the parser then refuses the config naming transport.url, rather than the
      # daemon failing later against an address it cannot dial.
      RELAY_URL_OK=""
      if [ "$TRANSPORT" = "relay" ]; then
        RELAY_URL="$(printf '%s' "$RELAY_URL" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        case "$RELAY_URL" in
          ws://?*|wss://?*) RELAY_URL_OK="$RELAY_URL" ;;
          "")
            echo "otzi-headless: WARNING — no relay URL given: it must be a ws:// or wss:// URL, for example wss://relay.example." >&2
            echo "otzi-headless: set url under [transport] in /etc/otzi/daemon.toml before running 'otzi setup'." >&2
            ;;
          *)
            echo "otzi-headless: WARNING — ignoring relay URL '$RELAY_URL': it must be a ws:// or wss:// URL, for example wss://relay.example." >&2
            echo "otzi-headless: set url under [transport] in /etc/otzi/daemon.toml before running 'otzi setup'." >&2
            ;;
        esac
      fi

      ENODE_ID="$(toml_escape "$NODE_ID")"
      EESPLORA_URL="$(toml_escape "$ESPLORA_URL")"
      EADVERTISED="$(toml_escape "$ADVERTISED")"
      ERELAY_URL="$(toml_escape "$RELAY_URL_OK")"
      EBOOTSTRAP_BIND="$(toml_escape "$BOOTSTRAP_BIND")"
      EBOOTSTRAP_LEADER_URL="$(toml_escape "$BOOTSTRAP_LEADER_URL")"

      umask 027
      cat >/etc/otzi/daemon.toml <<EOF
# Generated by otzi-headless postinst on $(date -u +%Y-%m-%dT%H:%M:%SZ).
# Edit freely — postinst will not regenerate this file on package upgrades.
# To re-run debconf: remove this file, then \`dpkg-reconfigure otzi-headless\`.

[share]
path = "/var/lib/otzi/share.json"
password_env = "OTZI_SHARE_PASSWORD"

[node]
id = "$ENODE_ID"
identity_key_file = "/var/lib/otzi/identity.json"
pubkey_book_file = "/var/lib/otzi/pubkeys.json"

[network]
name = "$NETWORK"
EOF

      if [ -n "$ESPLORA_URL" ]; then
        cat >>/etc/otzi/daemon.toml <<EOF
esplora_url = "$EESPLORA_URL"
EOF
      fi
      printf '\n' >>/etc/otzi/daemon.toml

      if [ "$TRANSPORT" = "relay" ]; then
        cat >>/etc/otzi/daemon.toml <<EOF
[transport]
kind = "relay"
EOF
        if [ -n "$RELAY_URL_OK" ]; then
          cat >>/etc/otzi/daemon.toml <<EOF
url = "$ERELAY_URL"
EOF
        fi
        printf '\n' >>/etc/otzi/daemon.toml
      else
        cat >>/etc/otzi/daemon.toml <<EOF
[transport]
kind = "peer-mesh"
advertised_endpoint = "$EADVERTISED"

EOF
      fi

      # [[peers]] rendering — operator-supplied CSV of `host[:port]`. For
      # leaves, prepend an auto-derived entry for the leader (the operator
      # already typed the leader URL; no need to retype the leader's host
      # again under "Other peers"). All values are written verbatim — the
      # daemon's TOML parser canonicalizes (default port, lowercase host,
      # RFC 5952 IPv6 collapse) on startup.
      if [ "$TRANSPORT" != "relay" ]; then
        if [ "$ROLE" = "leaf" ] && [ -n "$BOOTSTRAP_LEADER_URL" ]; then
          # Strip scheme + path + port: http://leader-host:7090/path → leader-host
          LEADER_HOST=$(printf '%s' "$BOOTSTRAP_LEADER_URL" \
            | sed -E 's#^[a-zA-Z]+://##; s#[/?#].*$##; s#:[0-9]+$##')
          if [ -n "$LEADER_HOST" ]; then
            ELEADER_HOST="$(toml_escape "$LEADER_HOST")"
            cat >>/etc/otzi/daemon.toml <<EOF
[[peers]]
endpoint = "$ELEADER_HOST:8800"

EOF
          fi
        fi

        if [ -n "$PEERS_CSV" ]; then
          # CSV split on commas; trim whitespace; skip empties. POSIX sh
          # avoids `read`-in-pipeline-subshell issues by iterating a saved
          # IFS-split list.
          OLD_IFS="$IFS"
          IFS=','
          for RAW_PEER in $PEERS_CSV; do
            # Trim leading + trailing whitespace.
            PEER=$(printf '%s' "$RAW_PEER" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            [ -z "$PEER" ] && continue
            EPEER="$(toml_escape "$PEER")"
            cat >>/etc/otzi/daemon.toml <<EOF
[[peers]]
endpoint = "$EPEER"

EOF
          done
          IFS="$OLD_IFS"
        fi
      fi

      cat >>/etc/otzi/daemon.toml <<EOF
[gate]
strategy = "auto"

[deadlines]
signing_ms = 300000
dkg_ms = 900000

[bootstrap]
role = "$ROLE"
EOF

      if [ "$ROLE" = "leader" ]; then
        cat >>/etc/otzi/daemon.toml <<EOF
bind = "$EBOOTSTRAP_BIND"
EOF
        if [ -n "$PARTIES_OK" ]; then
          printf 'parties = %s\n' "$PARTIES_OK" >>/etc/otzi/daemon.toml
        fi
        printf '\n' >>/etc/otzi/daemon.toml
      else
        cat >>/etc/otzi/daemon.toml <<EOF
leader_url = "$EBOOTSTRAP_LEADER_URL"

EOF
      fi

      cat >>/etc/otzi/daemon.toml <<EOF
[[triggers]]
kind = "uds"
path = "/var/run/otzi/otzi.sock"
EOF

      chown root:otzi /etc/otzi/daemon.toml
      chmod 640 /etc/otzi/daemon.toml

      # Print the next steps, in the order docs/install.md walks through.
      cat <<EOF

otzi-headless installed. Next steps:

  1. Bootstrap pubkey exchange, leader first. Compare the printed fingerprint
     on every node, confirm every key id it lists belongs to one of your nodes,
     and count its party lines (exactly one per node), before going further:
       sudo -u otzi otzi setup /etc/otzi/daemon.toml
  2. Create /etc/otzi/otzi.env (owner root:root, mode 600) with one line. The
     unit loads it, and the daemon refuses to start without the password
     (systemd interprets quotes and backslashes there: avoid them):
       sudo install -m 600 -o root -g root /dev/null /etc/otzi/otzi.env
       sudoedit /etc/otzi/otzi.env   # OTZI_SHARE_PASSWORD=<a strong password>
  3. Enable + start the daemon on every node:
       sudo systemctl enable --now otzi
  4. Run the DKG on one node (every other daemon must be running):
       sudo -u otzi otzi generate
  5. Restart every daemon so it loads its share, then check the vault:
       sudo systemctl restart otzi
       otzi vault
EOF

      # Relay transport: the steps above are the same, but a relay server has to
      # run somewhere. docs/install.md, Relay coordinator, has the details.
      if [ "$TRANSPORT" = "relay" ]; then
        if [ -n "$RELAY_URL_OK" ]; then
          RELAY_URL_NOTE="this node: $RELAY_URL_OK"
        else
          RELAY_URL_NOTE="this node has none yet: add it under [transport]"
        fi
        cat <<EOF

Relay coordinator (relay transport). One host runs the relay server for the
whole ring: one of the ring nodes, or a separate host. Start it before the
daemons (step 3) if you can. A daemon that starts first just redials the relay,
backing off from 1 s to 30 s, so the order is not strict:
  a. Install this package on the coordinator host. It ships otzi-relay.service,
     installed DISABLED: nothing starts the relay for you.
  b. The relay listens on the address in /etc/otzi/relay.env (root:root, mode
     644; default OTZI_RELAY_LISTEN=127.0.0.1:7100, loopback only). Edit it as
     root if the reverse proxy runs on another host or port.
  c. Put a TLS reverse proxy in front of it: it serves wss://<relay-host> and
     forwards the WebSocket traffic to that address. The relay speaks plain
     WebSocket and has no login of its own: never expose it unencrypted beyond
     loopback or a VPN.
  d. Start it on the coordinator host (logs: journalctl -u otzi-relay):
       sudo systemctl enable --now otzi-relay
  e. On every node, [transport] url in /etc/otzi/daemon.toml must be that
     wss:// URL ($RELAY_URL_NOTE).
Under relay the bootstrap leader admits members by count, so during step 1 keep
the leader's bootstrap port reachable only by the ring members (a VPN address,
or a loopback bind reached through an SSH tunnel, rather than 0.0.0.0), and set
the leader's [bootstrap] parties to the number of nodes.
EOF
        if [ -n "$PARTIES_OK" ]; then
          cat <<EOF
Ring size: $PARTIES_OK nodes ([bootstrap] parties in /etc/otzi/daemon.toml); the
leader admits $((PARTIES_OK - 1)) registrations.
EOF
        fi
      fi

      cat <<EOF

Operators (in 'otzi' group): $OPERATORS
Config: /etc/otzi/daemon.toml         (mode 640, owned root:otzi)
        /etc/otzi/                    (mode 2750, owned root:otzi setgid;
                                       only root writes, group otzi reads)
Secret: /etc/otzi/otzi.env            (you create it: mode 600, owned root:root)
Data:   /var/lib/otzi/                (mode 2770, owned root:otzi setgid)
UDS:    /var/run/otzi/otzi.sock       (owned otzi:otzi; exists while the daemon runs)
Logs:   journalctl -u otzi
EOF
    fi
    ;;
esac

db_stop || true

exit 0
