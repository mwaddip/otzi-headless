#!/bin/sh
# Phase-6a stub. Phase 6c expands this with debconf rendering of /etc/otzi/daemon.toml.
set -e

case "$1" in
  configure)
    if ! getent passwd otzi >/dev/null 2>&1; then
      adduser --system --group --no-create-home \
              --home /var/lib/otzi --shell /usr/sbin/nologin otzi
    fi

    [ -d /var/lib/otzi ] || mkdir -p /var/lib/otzi
    chown otzi:otzi /var/lib/otzi
    chmod 750 /var/lib/otzi

    [ -d /etc/otzi ] || mkdir -p /etc/otzi
    chown root:otzi /etc/otzi
    chmod 750 /etc/otzi

    if [ -d /run/systemd/system ]; then
      deb-systemd-helper enable otzi.service >/dev/null || true
    fi
    ;;
esac

exit 0
