#!/bin/sh
set -e

. /usr/share/debconf/confmodule

# Escape double-quotes + backslashes for safe inclusion in TOML basic strings.
toml_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

case "$1" in
  configure)
    if ! getent passwd otzi >/dev/null 2>&1; then
      adduser --system --group --no-create-home \
              --home /var/lib/otzi --shell /usr/sbin/nologin otzi
    fi

    # /etc/otzi: 2770 root:otzi (setgid) so group-otzi members can edit/install
    # manifests; new files inherit group otzi via setgid.
    [ -d /etc/otzi ] || mkdir -p /etc/otzi
    chown root:otzi /etc/otzi
    chmod 2770 /etc/otzi

    # /var/lib/otzi: 2770 root:otzi so group-otzi members can run setup
    # (writes identity.json + pubkeys.json) — daemon (otzi user) reads via
    # group membership. Setgid makes new files group-otzi.
    [ -d /var/lib/otzi ] || mkdir -p /var/lib/otzi
    chown root:otzi /var/lib/otzi
    chmod 2770 /var/lib/otzi

    # /var/run/otzi: holds the UDS socket. Created here for safety, but
    # systemd-tmpfiles also recreates it on boot (in case /var/run is tmpfs).
    [ -d /var/run/otzi ] || mkdir -p /var/run/otzi
    chown root:otzi /var/run/otzi
    chmod 2770 /var/run/otzi

    # Add operator users to the otzi group.
    db_get otzi-headless/operators || true
    OPERATORS="$RET"
    for U in $OPERATORS; do
      if getent passwd "$U" >/dev/null 2>&1; then
        usermod -aG otzi "$U" || true
        echo "otzi-headless: added user '$U' to group 'otzi'"
      else
        echo "otzi-headless: WARNING — user '$U' does not exist; skipping group add" >&2
      fi
    done

    # Restore-from-backup branch (run BEFORE bootstrap-secret + daemon.toml
    # render). If the operator picked "yes" at the debconf prompt, pipe the
    # password to `otzi restore --password-stdin <path>` and short-circuit the
    # fresh-install path. NEVER pass the password as an argv flag — it would
    # leak via /proc/<pid>/cmdline + ps. db_reset wipes the password from
    # /var/cache/debconf/passwords.dat on EVERY exit path.
    db_get otzi-headless/restore-from-backup || true
    RESTORE_REQUESTED="$RET"
    if [ "$RESTORE_REQUESTED" = "true" ]; then
      db_get otzi-headless/backup-path || true
      BACKUP_PATH="$RET"
      db_get otzi-headless/backup-password || true
      BACKUP_PASSWORD="$RET"

      if [ -z "$BACKUP_PATH" ] || [ -z "$BACKUP_PASSWORD" ]; then
        echo "otzi-headless: restore selected but backup-path or backup-password is empty" >&2
        db_reset otzi-headless/backup-password 2>/dev/null || true
        exit 1
      fi

      if [ ! -f "$BACKUP_PATH" ]; then
        echo "otzi-headless: backup file not found at $BACKUP_PATH" >&2
        db_reset otzi-headless/backup-password 2>/dev/null || true
        exit 1
      fi

      echo "otzi-headless: attempting restore from $BACKUP_PATH"
      if printf '%s\n' "$BACKUP_PASSWORD" | otzi restore --password-stdin "$BACKUP_PATH"; then
        # Wipe password from debconf cache before continuing.
        db_reset otzi-headless/backup-password 2>/dev/null || true
        echo "otzi-headless: restored from backup; skipping fresh-install configuration"
        cat <<'BANNER'

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  otzi-headless restored from backup.

  Verify the restored config:
    sudo cat /etc/otzi/daemon.toml
  Then start the daemon:
    sudo systemctl enable --now otzi
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

BANNER
        db_stop || true
        exit 0
      else
        # Restore failed — wipe password and abort. Operator can
        # `dpkg-reconfigure otzi-headless` to retry (or decline restore).
        db_reset otzi-headless/backup-password 2>/dev/null || true
        echo "otzi-headless: restore failed. To retry: dpkg-reconfigure otzi-headless" >&2
        echo "otzi-headless: (or remove the package + reinstall with a valid backup)" >&2
        exit 1
      fi
    fi

    # Persist the bootstrap secret. It will be wiped by the daemon after
    # the first successful DKG.
    db_get otzi-headless/bootstrap-secret || true
    BOOTSTRAP_SECRET="$RET"
    if [ -n "$BOOTSTRAP_SECRET" ]; then
      umask 027
      printf '%s\n' "$BOOTSTRAP_SECRET" >/var/lib/otzi/bootstrap-secret
      chown root:otzi /var/lib/otzi/bootstrap-secret
      chmod 660 /var/lib/otzi/bootstrap-secret
    fi

    # Render daemon.toml only if missing — preserve operator edits across upgrades.
    if [ ! -f /etc/otzi/daemon.toml ]; then
      db_get otzi-headless/role || true;                  ROLE="$RET"
      db_get otzi-headless/network || true;               NETWORK="$RET"
      db_get otzi-headless/opnet-rpc || true;             OPNET_RPC="$RET"
      db_get otzi-headless/transport || true;             TRANSPORT="$RET"
      db_get otzi-headless/advertised-endpoint || true;   ADVERTISED="$RET"
      db_get otzi-headless/peers || true;                 PEERS_CSV="$RET"
      db_get otzi-headless/relay-url || true;             RELAY_URL="$RET"
      db_get otzi-headless/bootstrap-bind || true;        BOOTSTRAP_BIND="$RET"
      db_get otzi-headless/bootstrap-leader-url || true;  BOOTSTRAP_LEADER_URL="$RET"
      db_get otzi-headless/node-id || true;               NODE_ID="$RET"

      [ -n "$NODE_ID" ]        || NODE_ID="$(hostname -s 2>/dev/null || hostname)"
      [ -n "$NETWORK" ]        || NETWORK="testnet"
      [ -n "$OPNET_RPC" ]      || OPNET_RPC="https://testnet.opnet.org"
      [ -n "$TRANSPORT" ]      || TRANSPORT="peer-mesh"
      [ -n "$ROLE" ]           || ROLE="leaf"
      [ -n "$BOOTSTRAP_BIND" ] || BOOTSTRAP_BIND="0.0.0.0:7090"

      ENODE_ID="$(toml_escape "$NODE_ID")"
      EOPNET_RPC="$(toml_escape "$OPNET_RPC")"
      EADVERTISED="$(toml_escape "$ADVERTISED")"
      ERELAY_URL="$(toml_escape "$RELAY_URL")"
      EBOOTSTRAP_BIND="$(toml_escape "$BOOTSTRAP_BIND")"
      EBOOTSTRAP_LEADER_URL="$(toml_escape "$BOOTSTRAP_LEADER_URL")"

      umask 027
      cat >/etc/otzi/daemon.toml <<EOF
# Generated by otzi-headless postinst on $(date -u +%Y-%m-%dT%H:%M:%SZ).
# Edit freely — postinst will not regenerate this file on package upgrades.
# To re-run debconf: remove this file, then \`dpkg-reconfigure otzi-headless\`.

[share]
path = "/var/lib/otzi/share.json"
password_env = "OTZI_SHARE_PASSWORD"

[node]
id = "$ENODE_ID"
identity_key_file = "/var/lib/otzi/identity.json"
pubkey_book_file = "/var/lib/otzi/pubkeys.json"

[network]
name = "$NETWORK"
opnet_rpc = "$EOPNET_RPC"

EOF

      if [ "$TRANSPORT" = "relay" ]; then
        cat >>/etc/otzi/daemon.toml <<EOF
[transport]
kind = "relay"
url = "$ERELAY_URL"

EOF
      else
        cat >>/etc/otzi/daemon.toml <<EOF
[transport]
kind = "peer-mesh"
advertised_endpoint = "$EADVERTISED"

EOF
      fi

      # [[peers]] rendering — operator-supplied CSV of `host[:port]`. For
      # leaves, prepend an auto-derived entry for the leader (the operator
      # already typed the leader URL; no need to retype the leader's host
      # again under "Other peers"). All values are written verbatim — the
      # daemon's TOML parser canonicalizes (default port, lowercase host,
      # RFC 5952 IPv6 collapse) on startup.
      if [ "$TRANSPORT" != "relay" ]; then
        if [ "$ROLE" = "leaf" ] && [ -n "$BOOTSTRAP_LEADER_URL" ]; then
          # Strip scheme + path + port: http://leader-host:7090/path → leader-host
          LEADER_HOST=$(printf '%s' "$BOOTSTRAP_LEADER_URL" \
            | sed -E 's#^[a-zA-Z]+://##; s#[/?#].*$##; s#:[0-9]+$##')
          if [ -n "$LEADER_HOST" ]; then
            ELEADER_HOST="$(toml_escape "$LEADER_HOST")"
            cat >>/etc/otzi/daemon.toml <<EOF
[[peers]]
endpoint = "$ELEADER_HOST:8800"

EOF
          fi
        fi

        if [ -n "$PEERS_CSV" ]; then
          # CSV split on commas; trim whitespace; skip empties. POSIX sh
          # avoids `read`-in-pipeline-subshell issues by iterating a saved
          # IFS-split list.
          OLD_IFS="$IFS"
          IFS=','
          for RAW_PEER in $PEERS_CSV; do
            # Trim leading + trailing whitespace.
            PEER=$(printf '%s' "$RAW_PEER" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            [ -z "$PEER" ] && continue
            EPEER="$(toml_escape "$PEER")"
            cat >>/etc/otzi/daemon.toml <<EOF
[[peers]]
endpoint = "$EPEER"

EOF
          done
          IFS="$OLD_IFS"
        fi
      fi

      cat >>/etc/otzi/daemon.toml <<EOF
[gate]
strategy = "auto"

[deadlines]
signing_ms = 300000
dkg_ms = 900000

[bootstrap]
role = "$ROLE"
EOF

      if [ "$ROLE" = "leader" ]; then
        cat >>/etc/otzi/daemon.toml <<EOF
bind = "$EBOOTSTRAP_BIND"

EOF
      else
        cat >>/etc/otzi/daemon.toml <<EOF
leader_url = "$EBOOTSTRAP_LEADER_URL"

EOF
      fi

      cat >>/etc/otzi/daemon.toml <<EOF
[[triggers]]
kind = "uds"
path = "/var/run/otzi/otzi.sock"
EOF

      chown root:otzi /etc/otzi/daemon.toml
      chmod 640 /etc/otzi/daemon.toml

      # Print role-conditional next steps.
      cat <<EOF

otzi-headless installed. Next steps:

  1. Bootstrap pubkey exchange:
       sudo -u otzi otzi setup /etc/otzi/daemon.toml
  2. Generate the threshold share:
       sudo -u otzi otzi generate /etc/otzi/daemon.toml
  3. Enable + start the daemon:
       sudo systemctl enable --now otzi

Operators (in 'otzi' group): $OPERATORS
Config: /etc/otzi/daemon.toml (chmod 640, owned root:otzi)
Data:   /var/lib/otzi/                (mode 2770, owned root:otzi setgid)
UDS:    /var/run/otzi/otzi.sock       (mode 660, owned otzi:otzi)
Logs:   journalctl -u otzi
EOF
    fi
    ;;
esac

db_stop || true

exit 0
