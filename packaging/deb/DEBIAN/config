#!/bin/sh
set -e

. /usr/share/debconf/confmodule

# Restore-from-backup branch — asked first, so an operator reinstalling on a
# fresh host can short-circuit the rest of the prompts. If declined (default),
# fall through to the normal fresh-install prompt flow. If accepted, postinst
# will run `otzi restore`; on success the rest of the config flow is skipped,
# on failure postinst exits non-zero (operator can `dpkg-reconfigure` to retry
# or decline restore).
db_input high otzi-headless/restore-from-backup || true
db_go || true
db_get otzi-headless/restore-from-backup || true
if [ "$RET" = "true" ]; then
  db_input critical otzi-headless/backup-path || true
  db_input critical otzi-headless/backup-password || true
  db_go || true
  # Skip the rest of the prompts — postinst short-circuits on restore success.
  exit 0
fi

# Pre-seed defaults conditionally
db_get otzi-headless/network || true
case "$RET" in
  mainnet) db_set otzi-headless/opnet-rpc "https://api.opnet.org" ;;
  testnet) db_set otzi-headless/opnet-rpc "https://testnet.opnet.org" ;;
  regtest) db_set otzi-headless/opnet-rpc "http://127.0.0.1:9001" ;;
esac

db_get otzi-headless/node-id || true
[ -z "$RET" ] && db_set otzi-headless/node-id "$(hostname -s 2>/dev/null || hostname)"

# Ask high-priority prompts in order.
db_input high otzi-headless/role || true
db_input high otzi-headless/operators || true
db_input high otzi-headless/bootstrap-secret || true
db_input high otzi-headless/network || true
db_input high otzi-headless/transport || true

db_go || true

# Conditional sub-prompts based on transport choice.
db_get otzi-headless/transport || true
TRANSPORT="$RET"
if [ "$TRANSPORT" = "relay" ]; then
  db_input high otzi-headless/relay-url || true
else
  db_input high otzi-headless/advertised-endpoint || true
  db_input high otzi-headless/peers || true
fi

# Conditional sub-prompts based on role choice.
db_get otzi-headless/role || true
ROLE="$RET"
if [ "$ROLE" = "leader" ]; then
  db_input medium otzi-headless/bootstrap-bind || true
else
  db_input high otzi-headless/bootstrap-leader-url || true
fi

# Other medium-priority prompts.
db_input medium otzi-headless/opnet-rpc || true
db_input medium otzi-headless/node-id || true

db_go || true
