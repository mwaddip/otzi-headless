{
  "name": "otzi-headless",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Headless daemon variant of Ötzi: a FROST threshold-signing Bitcoin vault for automated and federated systems.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:otzi",
    "test:otzi": "node --import tsx --test src/otzi/lib/*.test.ts src/otzi/backend/*.test.ts",
    "test:watch": "vitest",
    "otzi": "tsx src/daemon/entrypoint.ts",
    "daemon": "tsx src/daemon/entrypoint.ts daemon",
    "setup": "tsx src/daemon/entrypoint.ts setup",
    "build:deb": "bash scripts/build-deb.sh"
  },
  "bin": {
    "otzi": "./bin/otzi"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "files": [
    "src",
    "bin",
    "tsconfig.json",
    "README.md"
  ],
  "dependencies": {
    "@mwaddip/frots": "^0.1.1",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "croner": "^10.0.1",
    "smol-toml": "^1.6.1",
    "tar": "^7.5.13",
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/tar": "^6.1.13",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
