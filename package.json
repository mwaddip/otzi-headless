{
  "name": "otzi-headless",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Headless daemon variant of Ötzi for automated threshold-signing (ML-DSA + FROST over OPNet Bitcoin L1).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "otzi": "tsx src/daemon/entrypoint.ts",
    "daemon": "tsx src/daemon/entrypoint.ts daemon",
    "setup": "tsx src/daemon/entrypoint.ts setup",
    "build:deb": "bash scripts/build-deb.sh"
  },
  "bin": {
    "otzi": "./bin/otzi"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "files": [
    "src",
    "bin",
    "vendor",
    "tsconfig.json",
    "README.md"
  ],
  "dependencies": {
    "@btc-vision/bip32": "^7.1.2",
    "@btc-vision/bitcoin": "^7.0.0",
    "@btc-vision/post-quantum": "file:vendor/post-quantum",
    "@btc-vision/transaction": "^1.8.6",
    "@mwaddip/frots": "^0.1.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "ajv": "^8.20.0",
    "croner": "^10.0.1",
    "opnet": "^1.8.13",
    "smol-toml": "^1.6.1",
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@preact/signals": "^1.3.4",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.28.0",
    "htm": "^3.1.1",
    "preact": "^10.29.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
